{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "Consulting/content.js"
    },
    "api/content.js": {
      "maxDuration": 10,
      "includeFiles": "Consulting/content.js"
    },
    "api/transcribe.js": {
      "maxDuration": 30
    },
    "api/tts.js": {
      "maxDuration": 30
    },
    "api/jobs.js": {
      "maxDuration": 15
    },
    "api/news.js": {
      "maxDuration": 15
    },
    "api/behaviorals.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/jobs",                "schedule": "0 6 * * *" },
    { "path": "/api/news?industry=all",   "schedule": "0 */2 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    }
  ]
}
